{
  "name": "pi-deepseek-websearch",
  "version": "0.1.0",
  "description": "Web search for pi via DeepSeek's server-side web_search tool. Registers a deepseek_search tool the model can call for current, source-backed information.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-search",
    "deepseek"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.2",
    "typebox": "^1.3.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
