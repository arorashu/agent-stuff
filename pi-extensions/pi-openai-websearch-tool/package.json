{
  "name": "pi-openai-websearch-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visible OpenAI Codex web search tool for Pi with confirmed hosted search events",
  "keywords": ["pi-package", "pi-extension", "web-search", "openai-codex"],
  "pi": { "extensions": ["./index.ts"] },
